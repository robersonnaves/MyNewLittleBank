{
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest",
    "Exchange": "svc.heartbeats",
    "DelayExchange": "delay.heartbeats",
    "DeadLetterExchange": "dlx.heartbeats",
    "RoutingKey": "heartbeats",
    "Queue": "queue.heartbeats",
    "DelayQueue": "delay.queue.heartbeats",
    "DeadLetterQueue": "dlq.heartbeats",
    "PrefetchCount": 5,
    "MaxRetries": 3,
    "RetryDelayMilliseconds": 5000
  },
  "Heartbeat": {
    "ServiceName": "heartbeat-worker",
    "Interval": "00:00:30",
    "MessageType": "heartbeat"
  },
  "OpenTelemetry": {
  "ServiceName": "MyNewLittleBank-Services-Heartbeats",
  "ServiceVersion": "1.0.0",
  "Environment": "Development",
  "Role": "Producer/Consumer",
  "Otlp": {
    "Endpoint": "http://otel-collector:4317"
  },
  "Tracing": {
    "Enabled": true,
    "Sampling": "AlwaysOn"
  },
  "Metrics": {
    "Enabled": true
  },
  "Logging": {
    "Enabled": true
  }
}
}