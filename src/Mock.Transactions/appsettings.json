{
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest",
    "Exchange": "svc.transactions",
    "DelayExchange": "delay.transactions",
    "DeadLetterExchange": "dlx.transactions",
    "RoutingKey": "pix.transactions",
    "Queue": "queue.transactions",
    "DelayQueue": "delay.transactions",
    "DeadLetterQueue": "dlq.transactions",
    "PrefetchCount": 10,
    "MaxRetries": 3,
    "RetryDelayMilliseconds": 5000
  },
  "MockTransactions": {
    "Seed": {
      "Enabled": true,
      "ReuseExisting": true,
      "Clients": 10,
      "MinAccountsPerClient": 1,
      "MaxAccountsPerClient": 3,
      "InitialBalance": 5000
    }
  },
  "OpenTelemetry": {
    "ServiceName": "MyNewLittleBank-MockTransactions",
    "ServiceVersion": "1.0.0",
    "Environment": "Development",
    "Role": "Producer",
    "Otlp": {
      "Endpoint": "http://otel-collector:4317"
    },
    "Tracing": {
      "Enabled": true,
      "Sampling": "AlwaysOn"
    },
    "Metrics": {
      "Enabled": true
    },
    "Logging": {
      "Enabled": true
    }
  }
}