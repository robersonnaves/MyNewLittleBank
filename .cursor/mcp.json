{
	"mcpServers": {
		"task-master-ai": {
			"command": "npx",
			"args": [
				"-y",
				"task-master-ai"
			],
			"env": {
				"OPENAI_API_KEY": "${OPENAI_API_KEY}"
			}
		},
		"context7": {
			"url": "https://mcp.context7.com/mcp",
			"headers": {
				"CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
			}
		}
	}
}