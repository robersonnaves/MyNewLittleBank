# PostgreSQL Configuration
# Database credentials for the PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourSecurePasswordHere
POSTGRES_DB=mynewlittlebank
POSTGRES_PORT=5432

# RabbitMQ Configuration
# Message broker credentials
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# PgAdmin Configuration
# Web UI for PostgreSQL management
PGADMIN_DEFAULT_EMAIL=admin@yourdomain.com
PGADMIN_DEFAULT_PASSWORD=YourAdminPasswordHere

# Container Engine (optional)
# Uncomment to use Docker instead of Podman
# CONTAINER_ENGINE=docker

# Mock Transactions Control (optional)
# Set to 'false' to disable mock transaction generation
# MOCK_TRANSACTIONS_ENABLED=true
